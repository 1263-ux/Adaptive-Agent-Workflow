{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/adaptive_checkpoint.py\" --host=claude-code",
            "timeout": 10,
            "statusMessage": "Adaptive workflow checkpoint"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/adaptive_checkpoint.py\" --host=claude-code",
            "timeout": 10,
            "statusMessage": "Reviewing sub-agent handoff"
          }
        ]
      }
    ]
  }
}
